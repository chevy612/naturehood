# Naturehood observability stack
#
# Copy to .env before `docker compose up`. Do not commit the filled-in file.
# These values are placeholders. Point DNS at the VPS before requesting certificates.

ACME_EMAIL=ops@example.com
INGEST_DOMAIN=otel.example.com
GRAFANA_DOMAIN=grafana.example.com

# Shared by Caddy and Alloy. Send this to Vercel as OTEL_EXPORTER_OTLP_HEADERS.
# Generate with: openssl rand -base64 32
INGEST_BEARER_TOKEN=replace-with-a-long-random-token

GRAFANA_ADMIN_USER=naturehood
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
