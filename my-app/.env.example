# Supabase — copy this file to .env.local and fill in your project values
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api

NEXT_PUBLIC_SUPABASE_URL="https://jkaucsreqaywqxjwvteh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your_supabase_anon_key

# Supabase service role — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend — transactional email
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Naturehood <hello@contact.naturehoodofficial.com>"

# Where new-subscriber notifications are sent (defaults to team@naturehoodofficial.com if unset)
TEAM_NOTIFICATION_EMAIL="team@naturehoodofficial.com"

# Base URL for absolute asset links in emails (Sk Modernist web fonts + logo PNGs).
# Falls back to https://naturehoodofficial.com if unset; set in Vercel for prod.
# Dev tip: set to http://localhost:3000 in .env.local so the /dev/email-preview
# iframes load the fonts + logos from your local server.
NEXT_PUBLIC_SITE_URL="https://naturehoodofficial.com"

# Server log verbosity: debug | info | warn | error (defaults to debug).
# Set to info in Vercel for prod so [avatar] success/attempt (info) and error
# lines are emitted while noisier debug logs stay quiet.
LOG_LEVEL=info
